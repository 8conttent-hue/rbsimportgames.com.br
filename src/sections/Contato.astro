---
// Contato-D: Modern Cards - Design focado em canais diretos
import siteConfig from '../data/siteConfig.json';
const { email = 'contato@sf.com', socials = {} } = siteConfig as any;
interface Props { title: string; subtitle?: string; desc?: string; content?: string;
}
const { title, subtitle, desc, content } = Astro.props;
const description = subtitle || desc || '';

const contactCards = [
  { icon: '📧', label: 'E-mail Direto', value: email, sub: 'Resposta em 24h' },
  { icon: '📱', label: 'WhatsApp', value: socials.whatsapp || '(11) 99999-9999', sub: 'Suporte Rápido' },
  { icon: '📸', label: 'Instagram', value: socials.instagram || '@analise_tea', sub: 'Direct Aberto' }
];
---
<section class="py-24 bg-white overflow-hidden">
  <div class="max-w-6xl mx-auto px-4">
    <div class="grid lg:grid-cols-12 gap-16 items-start">
      
      <!-- Esquerda: Cards -->
      <div class="lg:col-span-5 grid gap-6">
        <div class="mb-8">
           <span class="text-[10px] font-black uppercase text-primary tracking-[0.4em] mb-4 block">Canais de Atendimento</span>
           <h1 class="text-4xl md:text-5xl font-black text-dark tracking-tighter uppercase leading-none">{title}</h1>
      {content && <p class="text-gray-500 mt-4 leading-relaxed">{content}</p>}
        </div>
        
        {contactCards.map(card => (
          <div class="p-8 rounded-3xl bg-gray-50 border border-gray-100 hover:bg-white hover:shadow-2xl transition-all group">
             <div class="flex items-center gap-6">
                <div class="text-4xl group-hover:scale-125 transition-transform">{card.icon}</div>
                <div>
                   <div class="text-[9px] font-black uppercase text-gray-400 tracking-widest mb-1">{card.label}</div>
                   <div class="text-lg font-black text-dark tracking-tight">{card.value}</div>
                   <p class="text-[10px] font-bold text-primary uppercase tracking-widest mt-1">{card.sub}</p>
                </div>
             </div>
          </div>
        ))}
      </div>

      <!-- Direita: Formulário -->
      <div class="lg:col-span-7 bg-dark rounded-[3rem] p-10 md:p-16 text-white shadow-2xl relative overflow-hidden group">
        <div class="absolute -top-20 -right-20 w-64 h-64 bg-primary/10 rounded-full blur-3xl group-hover:bg-primary/20 transition-colors"></div>
        
        <div class="relative z-10">
          <h2 class="text-3xl font-black mb-10 tracking-tight uppercase italic">{description}</h2>
          <form class="grid gap-6">
            <div class="grid md:grid-cols-2 gap-6">
              <input type="text" placeholder="Nome Completo" class="w-full bg-white/5 border border-white/10 rounded-2xl p-4 text-white focus:border-primary focus:outline-none transition-all" />
              <input type="email" placeholder="Seu E-mail" class="w-full bg-white/5 border border-white/10 rounded-2xl p-4 text-white focus:border-primary focus:outline-none transition-all" />
            </div>
            <textarea placeholder="Como podemos ajudar?" rows="5" class="w-full bg-white/5 border border-white/10 rounded-2xl p-4 text-white focus:border-primary focus:outline-none transition-all resize-none"></textarea>
            <button class="w-full bg-primary py-4 rounded-2xl font-black uppercase tracking-[0.3em] text-xs hover:bg-white hover:text-dark transition-all shadow-xl shadow-primary/20">
              Enviar Mensagem
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>